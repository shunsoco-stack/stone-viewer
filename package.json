{
  "name": "stone-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "石を見る — 何もしないを、ひとつ。1度ずつ石を眺める小さなデジタル美術館。",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run secret:scan && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
